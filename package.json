{
  "name": "book-reader",
  "private": true,
  "version": "1.0.0",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "dev:fixport": "kill-port 5173 5174 5175 5176 5177 5178 5179 5180 5181 5182 5183 || true && vite",
    "build": "vite build",
    "build:web": "vite build",
    "dev:electron": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron electron/main.js\"",
    "build:desktop": "cross-env VITE_PACKAGED=true vite build && electron-builder --config electron/electron-builder.config.js",
    "build:desktop:ci": "cross-env VITE_PACKAGED=true vite build && electron-builder --config electron/electron-builder.config.js --publish never",
    "cap:sync": "cross-env VITE_PACKAGED=true vite build && npx cap sync android",
    "cap:open": "npx cap open android",
    "build:mobile": "cross-env VITE_PACKAGED=true vite build && npx cap sync android && node scripts/build-apk.js",
    "clear:storage": "node scripts/clear_storage_and_firestore.js",
    "lint": "eslint .",
    "preview": "vite preview",
    "bootstrap": "npm install",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@firebase/firestore": "^4.15.0",
    "@supabase/supabase-js": "^2.32.0",
    "firebase": "^10.0.0",
    "idb": "^8.0.3",
    "pdfjs": "^2.5.4",
    "pdfjs-dist": "^3.6.172",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-icons": "^5.6.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "kill-port": "^2.0.1",
    "prettier": "^2.8.8",
    "supabase": "^2.104.0",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.12",
    "wait-on": "^7.2.0"
  },
  "allowScripts": {
    "electron@31.7.7": true
  }
}
